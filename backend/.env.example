# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/backend-ledger

# JWT Secrets
JWT_SECRET=super_secret_jwt_key_ledger_12345!@#$%

# Email / Nodemailer Configuration (Optional)
# Method 1 (Recommended): Gmail App Password (16-char generated in Google Account Security)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-character-app-password

# Method 2: Google Cloud OAuth2
# CLIENT_ID=your-google-oauth-client-id
# CLIENT_SECRET=your-google-oauth-client-secret
# REFRESH_TOKEN=your-google-oauth-refresh-token

